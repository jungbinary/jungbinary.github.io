---
import MinimaxPlot from './MinimaxPlot.astro'
import HopfPlot from './HopfPlot.astro'
import HmcPlot from './HmcPlot.astro'
---

<div data-alternating-plot>
  <div data-plot-variant="minimax"><MinimaxPlot /></div>
  <div data-plot-variant="hopf" hidden><HopfPlot /></div>
  <div data-plot-variant="hmc" hidden><HmcPlot /></div>
  <script is:inline>
    (() => {
      const root = document.currentScript?.parentElement
      if (!root) return
      const variants = Array.from(root.querySelectorAll('[data-plot-variant]'))
      const names = variants.map((variant) => variant.getAttribute('data-plot-variant'))
      let next = Math.random() < 0.4 ? 'minimax' : 'hmc'
      try {
        const previous = sessionStorage.getItem('jungbin-last-plot')
        const index = names.indexOf(previous)
        if (index >= 0) next = names[(index + 1) % names.length]
      } catch {}
      const requested = new URLSearchParams(location.search).get('plot')
      if (names.includes(requested)) next = requested
      try { sessionStorage.setItem('jungbin-last-plot', next) } catch {}
      const selected = variants.find((variant) => variant.getAttribute('data-plot-variant') === next)
      for (const variant of variants) {
        if (variant === selected) variant.removeAttribute('hidden')
        else variant.remove()
      }
      root.dataset.activePlot = selected?.getAttribute('data-plot-variant')
    })()
  </script>
</div>
