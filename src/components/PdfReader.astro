---
const { src, title } = Astro.props
---

<div class="pdf-reader" data-pdf-reader data-pdf-src={src} aria-busy="true">
  <div class="pdf-reader-toolbar">
    <div class="pdf-reader-label">
      <i class="fa-regular fa-file-pdf" aria-hidden="true"></i>
      <span>{title}</span>
    </div>
    <div class="pdf-reader-actions">
      <span class="pdf-page-count" data-page-count>Loading…</span>
      <span class="pdf-toolbar-divider" aria-hidden="true"></span>
      <button type="button" data-zoom-out aria-label="Zoom out">−</button>
      <span class="pdf-zoom-value" data-zoom-value>100%</span>
      <button type="button" data-zoom-in aria-label="Zoom in">+</button>
      <a
        href={src}
        target="_blank"
        rel="noopener nofollow"
        aria-label={`Open ${title} PDF in a new tab`}
        title="Open original PDF"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M14 3h7v7M21 3l-11 11" />
          <path d="M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5" />
        </svg>
      </a>
    </div>
  </div>
  <div class="pdf-reader-viewport" data-pdf-pages>
    <div class="pdf-loading" data-pdf-loading>
      <span></span>
      Rendering notes…
    </div>
  </div>
</div>

<script>
  import {
    getDocument,
    GlobalWorkerOptions,
    type PDFDocumentProxy,
  } from 'pdfjs-dist'
  import pdfWorker from 'pdfjs-dist/build/pdf.worker.min.mjs?url'

  GlobalWorkerOptions.workerSrc = pdfWorker

  const reader = document.querySelector('[data-pdf-reader]')
  const pages = reader?.querySelector('[data-pdf-pages]')
  const pageCount = reader?.querySelector('[data-page-count]')
  const zoomValue = reader?.querySelector('[data-zoom-value]')
  const zoomOut = reader?.querySelector('[data-zoom-out]')
  const zoomIn = reader?.querySelector('[data-zoom-in]')
  const pdfSrc = reader instanceof HTMLElement ? reader.dataset.pdfSrc : ''
  let pdfDocument: PDFDocumentProxy | undefined
  let zoom = 1
  let renderVersion = 0

  const renderPdf = async () => {
    if (!(pages instanceof HTMLElement) || !pdfDocument) return

    const version = ++renderVersion
    pages.replaceChildren()

    for (let pageNumber = 1; pageNumber <= pdfDocument.numPages; pageNumber++) {
      if (version !== renderVersion) return

      const page = await pdfDocument.getPage(pageNumber)
      const baseViewport = page.getViewport({ scale: 1 })
      const availableWidth = Math.max(280, pages.clientWidth - 56)
      const fitScale = Math.min(availableWidth / baseViewport.width, 1.45)
      const viewport = page.getViewport({ scale: fitScale * zoom })
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2)
      const canvas = document.createElement('canvas')
      const context = canvas.getContext('2d')

      if (!context) continue

      canvas.className = 'pdf-page'
      canvas.setAttribute('aria-label', `Page ${pageNumber}`)
      canvas.width = Math.floor(viewport.width * pixelRatio)
      canvas.height = Math.floor(viewport.height * pixelRatio)
      canvas.style.width = `${Math.floor(viewport.width)}px`
      canvas.style.height = `${Math.floor(viewport.height)}px`
      pages.append(canvas)

      await page.render({
        canvas,
        canvasContext: context,
        viewport,
        transform:
          pixelRatio === 1 ? undefined : [pixelRatio, 0, 0, pixelRatio, 0, 0],
      }).promise
    }

    if (version === renderVersion && reader instanceof HTMLElement) {
      reader.setAttribute('aria-busy', 'false')
    }
  }

  const loadPdf = async () => {
    if (pdfDocument || !pdfSrc) return

    try {
      pdfDocument = await getDocument({ url: pdfSrc }).promise
      if (pageCount instanceof HTMLElement) {
        pageCount.textContent = `${pdfDocument.numPages} pages`
      }
      await renderPdf()
    } catch {
      if (pages instanceof HTMLElement) {
        pages.innerHTML = `<p class="pdf-error">The preview could not be loaded. <a href="${pdfSrc}">Open the PDF</a>.</p>`
      }
    }
  }

  zoomOut?.addEventListener('click', () => {
    zoom = Math.max(0.75, zoom - 0.25)
    if (zoomValue instanceof HTMLElement) {
      zoomValue.textContent = `${Math.round(zoom * 100)}%`
    }
    void renderPdf()
  })

  zoomIn?.addEventListener('click', () => {
    zoom = Math.min(1.5, zoom + 0.25)
    if (zoomValue instanceof HTMLElement) {
      zoomValue.textContent = `${Math.round(zoom * 100)}%`
    }
    void renderPdf()
  })

  void loadPdf()
</script>
