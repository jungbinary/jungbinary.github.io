---
import { axes, ballFrame, ballRadius, mesh, meshOpacity, minimax, pathData, trajectory } from '../lib/minimax'

const angle = minimax.initialAngle
const initialBall = ballFrame(0, angle)
---

<figure class="minimax-plot" data-minimax-plot>
  <div class="minimax-stage">
    <svg
      class="minimax-svg"
      viewBox="0 0 320 232"
      role="group"
      tabindex="0"
      aria-label="Interactive minimax plot"
      aria-describedby="minimax-description"
      data-minimax-surface
    >
      <desc id="minimax-description">
        A wireframe of f(x,y) = {minimax.mu / 2}(x² − y²) + {minimax.lambda}xy. An orange
        descent–ascent trajectory spirals toward the equilibrium at the origin.
        Hover over the orange equilibrium to identify it, and click it to read about
        the minimax theorem. Click elsewhere on the surface to choose a starting point,
        or press Enter or Space to explore a sample trajectory.
        Clicks outside the surface snap to its nearest point.
        Otherwise, new trajectories start automatically at random points while the saddle rotates.
      </desc>
      <defs>
        <radialGradient id="minimax-ball-shading" cx="30%" cy="25%" r="90%">
          <stop offset="0" stop-color="var(--ball-light)" />
          <stop offset="0.48" stop-color="var(--ball-light)" />
          <stop offset="0.54" stop-color="var(--ball-mid)" />
          <stop offset="0.8" stop-color="var(--ball-mid)" />
          <stop offset="0.86" stop-color="var(--ball-shadow)" />
          <stop offset="1" stop-color="var(--ball-shadow)" />
        </radialGradient>
        <radialGradient id="minimax-equilibrium-glow">
          <stop offset="0" stop-color="var(--plot-orbit)" stop-opacity="0.3" />
          <stop offset="0.45" stop-color="var(--plot-orbit)" stop-opacity="0.12" />
          <stop offset="1" stop-color="var(--plot-orbit)" stop-opacity="0" />
        </radialGradient>
      </defs>
      <g class="minimax-axes">
        {axes.map((axis) => (
          <path d={pathData(axis.points, angle)} data-minimax-axis />
        ))}
      </g>
      <g class="minimax-mesh">
        {mesh.map((line) => (
          <path
            d={pathData(line.points, angle)}
            opacity={meshOpacity(line.points, angle)}
            class:list={{ 'minimax-central-line': line.central }}
            data-minimax-grid
          />
        ))}
      </g>
      <path class="minimax-trajectory" d={pathData(trajectory, angle)} data-minimax-trajectory />
      <circle class="minimax-start" r="2.4" visibility="hidden" data-minimax-start />
      <a
        class="minimax-equilibrium-target"
        href="https://en.wikipedia.org/wiki/Minimax_theorem"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Equilibrium: Minimax theorem on Wikipedia (opens in a new tab)"
        data-minimax-equilibrium
      >
        <circle class="minimax-equilibrium-halo" cx="160" cy="116" r="19" />
        <ellipse class="minimax-equilibrium-ring" cx="160" cy="116" rx="5.5" ry="2.6" />
        <circle class="minimax-equilibrium" cx="160" cy="116" r="2.5" />
        <circle class="minimax-equilibrium-hit" cx="160" cy="116" r="11" />
      </a>
      <g data-minimax-ball>
        <circle
          class="minimax-ball-contact"
          r={ballRadius * 1.15}
          transform={initialBall.shadowTransform}
          data-minimax-shadow
        />
        <g transform={initialBall.bodyTransform} data-minimax-ball-body>
          <circle class="minimax-ball-sphere" r={ballRadius} />
          <path class="minimax-ball-seam" d={initialBall.seam} data-minimax-ball-seam />
        </g>
      </g>
    </svg>
    <span class="minimax-cursor-hint" aria-hidden="true" data-minimax-cursor-hint>Click!</span>
    <span class="minimax-status" role="status" data-minimax-status></span>
  </div>
</figure>

<script>
  import { axes, ballFrame, createFlow, defaultFlow, flowPoint, mesh, meshOpacity, minimax, nearestSurfacePoint, pathData, pickSurface, project, randomInitial } from '../lib/minimax'
  import type { InitialPoint } from '../lib/minimax'

  document.querySelectorAll<HTMLElement>('[data-minimax-plot]').forEach((plot) => {
    const surface = plot.querySelector<SVGSVGElement>('[data-minimax-surface]')
    const cursorHint = plot.querySelector<HTMLElement>('[data-minimax-cursor-hint]')
    const start = plot.querySelector<SVGCircleElement>('[data-minimax-start]')
    const status = plot.querySelector<HTMLElement>('[data-minimax-status]')
    const gridPaths = plot.querySelectorAll<SVGPathElement>('[data-minimax-grid]')
    const axisPaths = plot.querySelectorAll<SVGPathElement>('[data-minimax-axis]')
    const curve = plot.querySelector<SVGPathElement>('[data-minimax-trajectory]')
    const ball = plot.querySelector<SVGGElement>('[data-minimax-ball]')
    const ballBody = plot.querySelector<SVGGElement>('[data-minimax-ball-body]')
    const ballShadow = plot.querySelector<SVGCircleElement>('[data-minimax-shadow]')
    const ballSeam = plot.querySelector<SVGPathElement>('[data-minimax-ball-seam]')
    if (!surface || !cursorHint || !start || !status || !curve || !ball || !ballBody || !ballShadow || !ballSeam) return

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const cycleDuration = minimax.duration / minimax.playbackRate
    let inView = true
    let phaseTime = 0
    let angle = minimax.initialAngle
    let renderedAngle = NaN
    let activeFlow = defaultFlow
    let selectedByUser = false
    let converged = false
    let sampleIndex = 0
    let previousTime = 0
    let lastRender = 0
    let frame = 0

    const beginFlow = (initial: InitialPoint, userSelected = false) => {
      activeFlow = createFlow(initial)
      selectedByUser = userSelected
      phaseTime = reducedMotion.matches ? cycleDuration : 0
      converged = false
      start.setAttribute('visibility', 'visible')
      // Announce deliberate selections without repeatedly announcing autoplay.
      status.textContent = userSelected
        ? `Gradient descent–ascent starting at x = ${initial.x.toFixed(2)}, y = ${initial.y.toFixed(2)}.`
        : ''
    }

    const render = () => {
      if (angle !== renderedAngle) {
        gridPaths.forEach((path, index) => {
          path.setAttribute('d', pathData(mesh[index].points, angle))
          path.setAttribute('opacity', String(meshOpacity(mesh[index].points, angle)))
        })
        axisPaths.forEach((path, index) => {
          path.setAttribute('d', pathData(axes[index].points, angle))
        })
        renderedAngle = angle
      }

      const t = Math.min(minimax.duration, phaseTime * minimax.playbackRate)
      const count = Math.floor(t / minimax.duration * (activeFlow.points.length - 1))
      const trail = activeFlow.points.slice(0, count + 1)
      if (t < minimax.duration) trail.push(flowPoint(t, activeFlow.initial))
      curve.setAttribute('d', pathData(trail, angle))
      const origin = project(activeFlow.points[0], angle)
      start.setAttribute('cx', String(origin.x))
      start.setAttribute('cy', String(origin.y))

      const pose = ballFrame(t, angle, activeFlow)
      // Fade between trajectories while pausing briefly at the equilibrium.
      ball.style.opacity = String(Math.min(1, phaseTime / 0.35, (minimax.duration - t) / 1.5))
      ballBody.setAttribute('transform', pose.bodyTransform)
      ballShadow.setAttribute('transform', pose.shadowTransform)
      ballSeam.setAttribute('d', pose.seam)
      if (t >= minimax.duration && !converged) {
        converged = true
        if (selectedByUser) status.textContent = 'The trajectory has converged near the equilibrium at x = 0, y = 0.'
      }
    }

    const tick = (now: number) => {
      if (previousTime) {
        const delta = Math.min((now - previousTime) / 1000, 0.1)
        phaseTime += delta
        // Camera rotation continues during both selected and automatic trajectories.
        angle += delta * 0.065
        if (phaseTime >= cycleDuration + minimax.restDuration) beginFlow(randomInitial())
      }
      previousTime = now
      if (now - lastRender >= 1000 / 30) {
        render()
        lastRender = now
      }
      frame = requestAnimationFrame(tick)
    }

    const sync = () => {
      if (!reducedMotion.matches && inView && !document.hidden) {
        if (!frame) frame = requestAnimationFrame(tick)
      } else {
        cancelAnimationFrame(frame)
        frame = 0
        previousTime = 0
      }
    }

    const explore = (initial: InitialPoint) => {
      beginFlow(initial, true)
      previousTime = 0
      render()
      sync()
    }

    const hideCursorHint = () => { cursorHint.dataset.visible = 'false' }
    surface.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch') {
        hideCursorHint()
        return
      }
      const nearEquilibrium = event.target instanceof Element
        && event.target.closest('[data-minimax-equilibrium]') !== null
      cursorHint.textContent = nearEquilibrium ? 'Equilibrium' : 'Click!'
      cursorHint.dataset.equilibrium = String(nearEquilibrium)
      // Keep the cue beside the pointer, including near the viewport edges.
      const x = event.clientX + 14 + cursorHint.offsetWidth > window.innerWidth - 8
        ? event.clientX - cursorHint.offsetWidth - 14
        : event.clientX + 14
      const y = event.clientY + 16 + cursorHint.offsetHeight > window.innerHeight - 8
        ? event.clientY - cursorHint.offsetHeight - 16
        : event.clientY + 16
      cursorHint.style.transform = `translate3d(${x}px, ${y}px, 0)`
      cursorHint.dataset.visible = 'true'
    })
    surface.addEventListener('pointerleave', hideCursorHint)
    surface.addEventListener('pointercancel', hideCursorHint)

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)
        || event.target.closest('a, button, input, textarea, select, summary, [role="button"], [role="link"], [contenteditable="true"]')
        || !window.getSelection()?.isCollapsed) return
      const matrix = surface.getScreenCTM()
      if (!matrix) return
      const point = new DOMPoint(event.clientX, event.clientY).matrixTransform(matrix.inverse())
      const displayAngle = Number.isNaN(renderedAngle) ? minimax.initialAngle : renderedAngle
      const initial = pickSurface(point.x, point.y, displayAngle)
        ?? nearestSurfacePoint(point.x, point.y, displayAngle)
      angle = displayAngle
      explore(initial)
    })
    surface.addEventListener('keydown', (event) => {
      if (event.target instanceof Element && event.target.closest('[data-minimax-equilibrium]')) return
      if (event.key !== 'Enter' && event.key !== ' ') return
      event.preventDefault()
      const theta = sampleIndex++ * Math.PI / 4 - 0.28
      explore({ x: 1.25 * Math.cos(theta), y: 1.25 * Math.sin(theta) })
    })
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) phaseTime = cycleDuration
      render()
      sync()
    })
    document.addEventListener('visibilitychange', () => {
      hideCursorHint()
      sync()
    })
    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting
      sync()
    })
    observer.observe(plot)
    window.addEventListener('pagehide', () => {
      cancelAnimationFrame(frame)
      observer.disconnect()
    }, { once: true })
    beginFlow(randomInitial())
    render()
    sync()
  })
</script>

<style>
  .minimax-plot {
    --plot-wire: #29466c;
    --plot-axis: #8090a3;
    --plot-orbit: #bb714a;
    --ball-light: #b7c6df;
    --ball-mid: #8da2c6;
    --ball-shadow: #6e85ae;
    --ball-edge: #5e7398;
    --ball-contact: #243249;
    position: absolute;
    top: 29px;
    right: 22px;
    width: min(360px, 45vw);
    margin: 0;
  }

  :global(html[data-theme='dark']) .minimax-plot {
    --plot-wire: #adc5e5;
    --plot-axis: #7f91a8;
    --plot-orbit: #e9ad83;
    --ball-light: #d3def1;
    --ball-mid: #a8bddc;
    --ball-shadow: #839cc4;
    --ball-edge: #637fa7;
    --ball-contact: #05080e;
  }

  .minimax-stage {
    position: relative;
  }

  .minimax-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    border-radius: 8px;
    outline: none;
    cursor: crosshair;
    -webkit-tap-highlight-color: transparent;
  }

  .minimax-svg path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .minimax-axes path {
    stroke: var(--plot-axis);
    stroke-width: 0.6;
    stroke-dasharray: 2 5;
    opacity: 0.48;
  }

  .minimax-mesh path {
    stroke: var(--plot-wire);
    stroke-width: 0.65;
  }

  .minimax-mesh .minimax-central-line {
    stroke-width: 0.9;
  }

  .minimax-svg .minimax-trajectory {
    stroke: var(--plot-orbit);
    stroke-width: 1.35;
    opacity: 0.87;
    pointer-events: none;
  }

  .minimax-start {
    fill: var(--page-bg);
    stroke: var(--plot-orbit);
    stroke-width: 1;
    pointer-events: none;
  }

  .minimax-equilibrium-target {
    cursor: default;
    outline: none;
  }

  .minimax-equilibrium-hit {
    fill: transparent;
    pointer-events: all;
  }

  .minimax-equilibrium-halo {
    fill: url(#minimax-equilibrium-glow);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .minimax-equilibrium-target:hover .minimax-equilibrium-halo,
  .minimax-equilibrium-target:focus-visible .minimax-equilibrium-halo,
  .minimax-svg:focus-visible .minimax-equilibrium-halo {
    opacity: 1;
  }

  .minimax-equilibrium-ring {
    fill: none;
    stroke: var(--plot-orbit);
    stroke-width: 0.6;
    opacity: 0.55;
  }

  .minimax-equilibrium {
    fill: var(--plot-orbit);
  }

  [data-minimax-ball] {
    pointer-events: none;
  }

  .minimax-ball-contact {
    fill: var(--ball-contact);
    opacity: 0.12;
  }

  .minimax-ball-sphere {
    fill: url(#minimax-ball-shading);
    stroke: var(--ball-edge);
    stroke-width: 0.5;
  }

  .minimax-svg .minimax-ball-seam {
    stroke: var(--ball-light);
    stroke-width: 0.4;
    opacity: 0.2;
  }

  .minimax-cursor-hint {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 2;
    color: var(--muted-color);
    font-size: 11px;
    font-style: italic;
    line-height: 1.4;
    white-space: nowrap;
    text-shadow: 0 0 4px var(--page-bg), 0 0 2px var(--page-bg);
    opacity: 0;
    transition: opacity 0.15s ease;
    pointer-events: none;
  }

  .minimax-cursor-hint[data-visible='true'] {
    opacity: 1;
  }

  .minimax-cursor-hint[data-equilibrium='true'] {
    color: var(--plot-orbit);
  }

  .minimax-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .minimax-plot {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .minimax-cursor-hint,
    .minimax-equilibrium-halo {
      transition: none;
    }
  }
</style>
