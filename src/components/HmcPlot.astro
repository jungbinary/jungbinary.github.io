<figure class="hmc-plot" data-hmc-plot>
  <div class="hmc-surface" tabindex="0" role="group"
    aria-label="Interactive 3D Hamiltonian Monte Carlo sample cloud"
    aria-describedby="hmc-description" data-hmc-surface>
    <canvas width="640" height="464" aria-hidden="true" data-hmc-canvas></canvas>
  </div>
  <a class="hmc-center" href="https://en.wikipedia.org/wiki/Hamiltonian_Monte_Carlo"
    target="_blank" rel="noopener noreferrer"
    aria-label="Hamiltonian Monte Carlo on Wikipedia (opens in a new tab)" data-hmc-center></a>
  <div class="hmc-controls">
    <button type="button" data-hmc-pause aria-label="Pause sampling" title="Pause sampling (Space)">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path class="hmc-pause-icon" d="M5 3.5v9M11 3.5v9" /><path class="hmc-play-icon" d="m5 3 7 5-7 5Z" /></svg>
    </button>
    <button type="button" data-hmc-reset aria-label="Reset the 3D view" title="Reset view (R)">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6.5a5.3 5.3 0 1 1 .5 4.1M3 2.8v3.7h3.7" /></svg>
    </button>
  </div>
  <span class="hmc-cursor-hint" aria-hidden="true" data-hmc-hint>Drag!</span>
  <span class="hmc-sr-only" id="hmc-description">
    The live Hamiltonian Monte Carlo chain starts at zero samples. A small,
    faint reference cloud and its x histogram show retained warmup states for
    context. A delicate wireframe traces one equal-density surface of the curved,
    three-dimensional target. A blue sphere follows a proposed leapfrog
    trajectory; brighter stationary beads mark states retained by the live
    chain. Gaussian momentum is refreshed before each proposal, and a Metropolis
    test accepts or rejects its endpoint. Rejection leaves the chain at its
    previous state. Drag to orbit the cloud, or click the center for Wikipedia.
    Space pauses, arrow keys rotate, and R resets the view. A faint curve shows
    the Gaussian target marginal of x.
  </span>
</figure>

<script>
  import { conditionalMeanY, createChain, createProjection, hmc, project, proposalPosition, propose } from '../lib/hmc'
  import { ballRadius } from '../lib/minimax'
  import type { Position } from '../lib/hmc'

  document.querySelectorAll<HTMLElement>('[data-hmc-plot]').forEach((plot) => {
    const surface = plot.querySelector<HTMLElement>('[data-hmc-surface]')
    const canvas = plot.querySelector<HTMLCanvasElement>('[data-hmc-canvas]')
    const hint = plot.querySelector<HTMLElement>('[data-hmc-hint]')
    const pauseButton = plot.querySelector<HTMLButtonElement>('[data-hmc-pause]')
    const resetButton = plot.querySelector<HTMLButtonElement>('[data-hmc-reset]')
    const context = canvas?.getContext('2d')
    if (!surface || !canvas || !context || !hint || !pauseButton || !resetButton) return

    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')
    const desktop = matchMedia('(min-width: 641px)')
    const chain = createChain()
    const reference = chain.samples.filter((_, index) => index % 3 === 0)
    // Warmup states provide a faint visual reference; the live sample count
    // starts at zero and grows independently from this background cloud.
    const camera = { ...hmc.initialCamera }
    let samples: Position[] = [], recent: Position[] = []
    let sampleCount = 0, proposal = propose(chain.q)
    let elapsed = 0, previousTime = 0, lastRender = 0, frame = 0
    let paused = false, inView = false, committed = false
    let drag: { id: number; x: number; y: number; yaw: number; elevation: number; moved: boolean } | null = null
    let colors: string[] = [], inks: string[] = [], halos: HTMLCanvasElement[] = [], referenceBeads: HTMLCanvasElement[] = []
    let dark = false
    let ballLight = '', ballEdge = ''
    let bead = document.createElement('canvas')
    const history: { path: Position[]; accepted: boolean }[] = []
    const histogramBins = 36, histogramMin = -4 * hmc.sigmaX, histogramMax = 4 * hmc.sigmaX
    const histogram = new Uint32Array(histogramBins)
    const barHeights = new Float32Array(histogramBins)
    let latestBin = -1
    const recordSample = (q: Position) => {
      if (q.x < histogramMin || q.x > histogramMax) return -1
      const bin = Math.min(histogramBins - 1, Math.floor((q.x - histogramMin) / (histogramMax - histogramMin) * histogramBins))
      histogram[bin]++
      return bin
    }
    const removeSample = (q: Position) => {
      if (q.x < histogramMin || q.x > histogramMax) return
      const bin = Math.min(histogramBins - 1, Math.floor((q.x - histogramMin) / (histogramMax - histogramMin) * histogramBins))
      histogram[bin] = Math.max(0, histogram[bin] - 1)
    }
    for (const q of reference) recordSample(q)
    const toneIndex = (q: Position) => Math.max(0, Math.min(23, Math.round((Math.tanh(q.x / 1.2) + 1) / 2 * 23)))
    const edgeFade = (x: number, y: number) => Math.max(0, Math.min(1, (x - 5) / 14, (315 - x) / 14, (y - 4) / 14, (173 - y) / 14))
    const densityContours: { points: Position[]; closed: boolean }[] = []
    const maxLiveSamples = 1100 - reference.length
    const shellRadius = 2.05
    const shellPoint = (x: number, angle: number, radial: number): Position => {
      const residualY = hmc.sigmaY * radial * Math.cos(angle)
      const residualZ = hmc.sigmaZ * radial * Math.sin(angle)
      return {
        x,
        y: conditionalMeanY(x) + residualY,
        z: hmc.twist * Math.sin(x) + hmc.coupling * residualY + residualZ,
      }
    }
    for (let longitude = 0; longitude < 8; longitude++) {
      const angle = Math.PI * 2 * longitude / 8
      const points = Array.from({ length: 65 }, (_, index) => {
        const standardizedX = shellRadius * (2 * index / 64 - 1)
        const radial = Math.sqrt(Math.max(0, shellRadius ** 2 - standardizedX ** 2))
        return shellPoint(standardizedX * hmc.sigmaX, angle, radial)
      })
      densityContours.push({ points, closed: false })
    }
    for (const standardizedX of [-1.7, -1.1, -0.55, 0, 0.55, 1.1, 1.7]) {
      const radial = Math.sqrt(shellRadius ** 2 - standardizedX ** 2)
      const points = Array.from({ length: 64 }, (_, index) =>
        shellPoint(standardizedX * hmc.sigmaX, Math.PI * 2 * index / 64, radial))
      densityContours.push({ points, closed: true })
    }

    const commitProposal = () => {
      if (committed) return
      samples.push({ ...proposal.next }); recent.push({ ...proposal.next }); sampleCount++
      latestBin = recordSample(proposal.next)
      if (samples.length > maxLiveSamples) {
        const removed = samples.shift()
        if (removed) removeSample(removed)
      }
      if (recent.length > 24) recent.shift()
      history.push({ path: proposal.path, accepted: proposal.accepted })
      if (history.length > 4) history.shift()
      committed = true
    }

    const render = () => {
      if (reducedMotion.matches) commitProposal()
      const view = createProjection(camera)
      const progress = reducedMotion.matches ? 1 : Math.max(0, Math.min(1, (elapsed - hmc.momentumDuration) / proposal.duration))
      const decided = reducedMotion.matches || elapsed >= hmc.momentumDuration + proposal.duration
      const phase = decided ? (proposal.accepted ? 'accepted' : 'rejected') : elapsed < hmc.momentumDuration ? 'momentum' : 'proposal'
      plot.dataset.phase = phase; plot.dataset.samples = String(sampleCount); plot.dataset.paused = String(paused)
      plot.dataset.cameraYaw = camera.yaw.toFixed(4)
      context.clearRect(0, 0, 320, 232)
      context.save(); context.beginPath(); context.rect(0, 0, 320, 176); context.clip()

      context.lineWidth = 0.52; context.lineCap = 'round'; context.lineJoin = 'round'
      context.strokeStyle = colors[1]
      for (const contour of densityContours) {
        const points = contour.points.map(point => project(point, camera, view))
        const averageDepth = points.reduce((sum, point) => sum + point.depth, 0) / points.length
        const near = Math.max(0, Math.min(1, (averageDepth + 2) / 4))
        context.globalAlpha = (dark ? 0.055 : 0.065) + (dark ? 0.09 : 0.12) * near
        context.setLineDash(averageDepth < 0 ? [1.2, 2.4] : [])
        context.beginPath()
        points.forEach((point, index) => index ? context.lineTo(point.x, point.y) : context.moveTo(point.x, point.y))
        if (contour.closed) context.closePath()
        context.stroke()
      }
      context.setLineDash([]); context.globalAlpha = 1

      const dots = [
        ...reference.map(q => ({ q, p: project(q, camera, view), reference: true })),
        ...samples.map(q => ({ q, p: project(q, camera, view), reference: false })),
      ]
      dots.sort((a, b) => a.p.depth - b.p.depth)
      // Generous, softly shaded reference beads keep individual states legible.
      // Live samples retain their broader density halos as the chain grows.
      for (const { q, p, reference: isReference } of dots) {
        const fade = edgeFade(p.x, p.y)
        if (!fade) continue
        const near = Math.max(0, Math.min(1, (p.depth + 3) / 6))
        const depthScale = 1 / (1 - p.depth * 0.055)
        const tone = toneIndex(q)
        if (isReference) {
          const size = (12 + 8 * near) * depthScale
          context.globalAlpha = fade * (dark ? 0.13 + 0.13 * near : 0.16 + 0.16 * near)
          context.drawImage(halos[tone], p.x - size / 2, p.y - size / 2, size, size)
          const diameter = (2.7 + 1.7 * near) * depthScale
          context.globalAlpha = fade * (dark ? 0.64 + 0.22 * near : 0.48 + 0.18 * near)
          context.drawImage(referenceBeads[tone], p.x - diameter / 2, p.y - diameter / 2, diameter, diameter)
          continue
        }
        const size = (9 + 7 * near) * depthScale
        context.globalAlpha = fade * (dark ? 0.065 + 0.08 * near : 0.08 + 0.1 * near)
        context.drawImage(halos[tone], p.x - size / 2, p.y - size / 2, size, size)
        context.fillStyle = inks[tone]
        context.globalAlpha = fade * (dark ? 0.21 + 0.4 * near : 0.27 + 0.43 * near)
        const radius = dark ? 0.3 + 0.4 * near : 0.4 + 0.48 * near
        context.beginPath(); context.arc(p.x, p.y, radius * depthScale, 0, 2 * Math.PI); context.fill()
      }

      const drawPath = (points: Position[], color: string, opacity: number, width: number, dashed = false) => {
        context.strokeStyle = color; context.globalAlpha = opacity; context.lineWidth = width
        context.setLineDash(dashed ? [1.2, 3] : []); context.beginPath()
        points.forEach((q, i) => { const p = project(q, camera, view); i ? context.lineTo(p.x, p.y) : context.moveTo(p.x, p.y) })
        context.stroke(); context.setLineDash([])
      }
      context.lineCap = 'round'; context.lineJoin = 'round'
      // Discrete, stationary states have a quieter visual language than the
      // continuous Hamiltonian proposal currently being traversed.
      drawPath(recent, colors[1], 0.16, 0.55, true)
      recent.forEach((q, i) => {
        const p = project(q, camera, view), fade = edgeFade(p.x, p.y)
        context.fillStyle = inks[toneIndex(q)]; context.globalAlpha = fade * (0.35 + 0.45 * i / recent.length)
        context.beginPath(); context.arc(p.x, p.y, 0.9 + 0.5 * i / recent.length, 0, 2 * Math.PI); context.fill()
      })
      history.forEach((past, i) => {
        if (past.path === proposal.path) return
        drawPath(past.path, past.accepted ? colors[1] : colors[5], (dark ? 0.045 : 0.07) + (dark ? 0.14 : 0.18) * ((i + 1) / history.length) ** 2, 0.8, !past.accepted)
      })
      const q = proposalPosition(proposal, progress)
      const count = Math.floor(progress * (proposal.path.length - 1))
      const trail = proposal.path.slice(0, count + 1); trail.push(q)
      const rejected = decided && !proposal.accepted
      drawPath(trail, rejected ? colors[5] : colors[4], 0.065, 3.4, rejected)
      drawPath(trail, rejected ? colors[5] : colors[4], 0.87, 1.1, rejected)

      const anchor = project(proposal.initial, camera, view)
      context.strokeStyle = colors[1]; context.lineWidth = 0.8; context.globalAlpha = 0.7
      context.beginPath(); context.arc(anchor.x, anchor.y, 2.15, 0, 2 * Math.PI); context.stroke()
      const returnTime = Math.min(1, Math.max(0, (elapsed - hmc.momentumDuration - proposal.duration) / 0.45))
      const blend = reducedMotion.matches ? 1 : returnTime * returnTime * (3 - 2 * returnTime)
      const position = rejected ? {
        x: q.x + (proposal.initial.x - q.x) * blend,
        y: q.y + (proposal.initial.y - q.y) * blend,
        z: q.z + (proposal.initial.z - q.z) * blend,
      } : q
      const ball = project(position, camera, view)
      if (phase === 'momentum') {
        const p = proposal.initialMomentum
        const arrow = project({ x: position.x + p.x * 0.24, y: position.y + p.y * 0.24, z: position.z + p.z * 0.24 }, camera, view)
        const angle = Math.atan2(arrow.y - ball.y, arrow.x - ball.x)
        context.strokeStyle = colors[4]; context.globalAlpha = 0.75; context.lineWidth = 0.8
        context.beginPath(); context.moveTo(ball.x, ball.y); context.lineTo(arrow.x, arrow.y)
        context.moveTo(arrow.x - 3 * Math.cos(angle - 0.45), arrow.y - 3 * Math.sin(angle - 0.45))
        context.lineTo(arrow.x, arrow.y)
        context.lineTo(arrow.x - 3 * Math.cos(angle + 0.45), arrow.y - 3 * Math.sin(angle + 0.45)); context.stroke()
      }
      if (decided && proposal.accepted) {
        context.strokeStyle = colors[1]; context.globalAlpha = 0.6 * (1 - returnTime * 0.5); context.lineWidth = 0.85
        context.beginPath(); context.arc(ball.x, ball.y, 2.3 + 4 * (1 - returnTime), 0, 2 * Math.PI); context.stroke()
      }
      // The blue sphere shares the minimax radius, banded shading, edge, and
      // etched meridian. Here it represents a proposed 3D state, without a floor.
      context.globalAlpha = 1
      context.drawImage(bead, ball.x - ballRadius, ball.y - ballRadius, 2 * ballRadius, 2 * ballRadius)
      context.strokeStyle = ballEdge; context.lineWidth = 0.5
      context.beginPath(); context.arc(ball.x, ball.y, ballRadius, 0, 2 * Math.PI); context.stroke()
      let distance = 0
      for (let i = 1; i < trail.length; i++) {
        const a = trail[i - 1], b = trail[i]
        distance += Math.hypot(a.x - b.x, a.y - b.y, a.z - b.z)
      }
      const rolling = distance * view.scale / ballRadius
      const next = project(proposalPosition(proposal, Math.min(1, progress + 0.005)), camera, view)
      context.save(); context.translate(ball.x, ball.y); context.rotate(Math.atan2(next.y - ball.y, next.x - ball.x))
      context.strokeStyle = ballLight; context.lineWidth = 0.4; context.globalAlpha = 0.2; context.beginPath()
      let connected = false
      for (let i = 0; i <= 72; i++) {
        const theta = 2 * Math.PI * i / 72
        if (Math.cos(rolling) * Math.cos(theta) < 0) { connected = false; continue }
        const x = ballRadius * Math.sin(rolling) * Math.cos(theta), y = ballRadius * Math.sin(theta)
        connected ? context.lineTo(x, y) : context.moveTo(x, y); connected = true
      }
      context.stroke(); context.restore(); context.restore(); context.globalAlpha = 1

      // The marginal is independent of camera orientation. Bin counts use
      // every retained state of this chain, including repeated rejected states.
      const left = 48, width = 224, baseline = 218, height = 30
      const binWidth = (histogramMax - histogramMin) / histogramBins
      const histogramTotal = histogram.reduce((sum, count) => sum + count, 0)
      const densities = Array.from(histogram, count => histogramTotal ? count / (histogramTotal * binWidth) : 0)
      const peak = Math.max(0.46, ...densities)
      plot.dataset.histogramTotal = String(histogramTotal)
      plot.dataset.histogramBinned = String(histogramTotal)
      const step = width / histogramBins
      for (let i = 0; i < histogramBins; i++) {
        const target = densities[i] / peak * height
        barHeights[i] += (target - barHeights[i]) * (reducedMotion.matches || paused ? 1 : 0.18)
        const x = histogramMin + (i + 0.5) * binWidth
        const fresh = i === latestBin && decided
        context.fillStyle = fresh ? colors[4] : inks[toneIndex({ x, y: 0, z: 0 })]
        context.globalAlpha = fresh ? 0.78 : dark ? 0.43 : 0.56
        context.fillRect(left + i * step + 0.6, baseline - barHeights[i], step - 1.2, barHeights[i])
      }
      context.strokeStyle = colors[3]; context.globalAlpha = dark ? 0.25 : 0.3; context.lineWidth = 0.45
      context.beginPath(); context.moveTo(left, baseline + 0.4); context.lineTo(left + width, baseline + 0.4); context.stroke()
      context.strokeStyle = colors[1]; context.globalAlpha = dark ? 0.33 : 0.48; context.lineWidth = 0.8
      context.beginPath()
      for (let i = 0; i <= 128; i++) {
        const x = histogramMin + i / 128 * (histogramMax - histogramMin)
        const density = Math.exp(-0.5 * (x / hmc.sigmaX) ** 2) / (hmc.sigmaX * Math.sqrt(2 * Math.PI))
        const sx = left + i / 128 * width, sy = baseline - density / peak * height
        i ? context.lineTo(sx, sy) : context.moveTo(sx, sy)
      }
      context.stroke()
      context.globalAlpha = 1
    }

    const resize = () => {
      const ratio = Math.min(devicePixelRatio || 1, 2)
      canvas.width = Math.max(320, Math.round(canvas.getBoundingClientRect().width * ratio))
      canvas.height = Math.round(canvas.width * 232 / 320)
      context.setTransform(canvas.width / 320, 0, 0, canvas.height / 232, 0, 0); render()
    }
    const updateColors = () => {
      const style = getComputedStyle(plot)
      dark = document.documentElement.dataset.theme === 'dark'
      colors = ['--hmc-blue', '--hmc-jade', '--hmc-violet', '--hmc-rib', '--hmc-copper', '--hmc-rejected'].map(name => style.getPropertyValue(name).trim())
      const parse = (hex: string) => [1, 3, 5].map(i => parseInt(hex.slice(i, i + 2), 16))
      const anchors = colors.slice(0, 3).map(parse)
      inks = []; halos = []; referenceBeads = []
      for (let i = 0; i < 24; i++) {
        const t = i / 23 * 2, a = Math.min(1, Math.floor(t)), mix = t - a
        const channels = anchors[a].map((c, j) => Math.round(c + (anchors[a + 1][j] - c) * mix))
        const rgb = channels.join(' ')
        inks.push(`rgb(${rgb})`)
        const sprite = document.createElement('canvas'); sprite.width = sprite.height = 32
        const c = sprite.getContext('2d')!, glow = c.createRadialGradient(16, 16, 0, 16, 16, 16)
        glow.addColorStop(0, `rgb(${rgb} / 0.8)`); glow.addColorStop(0.3, `rgb(${rgb} / 0.35)`); glow.addColorStop(1, `rgb(${rgb} / 0)`)
        c.fillStyle = glow; c.fillRect(0, 0, 32, 32); halos.push(sprite)
        const dot = document.createElement('canvas'); dot.width = dot.height = 24
        const d = dot.getContext('2d')!, pearl = d.createRadialGradient(8, 7, 0, 12, 12, 11)
        const light = channels.map(channel => Math.round(channel + (255 - channel) * (dark ? 0.3 : 0.44))).join(' ')
        const body = channels.map(channel => Math.round(channel + (255 - channel) * (dark ? 0 : 0.16))).join(' ')
        const edge = channels.map(channel => Math.round(dark ? channel * 0.82 : channel + (255 - channel) * 0.1)).join(' ')
        pearl.addColorStop(0, `rgb(${light})`); pearl.addColorStop(0.5, `rgb(${body})`); pearl.addColorStop(1, `rgb(${edge})`)
        d.fillStyle = pearl; d.beginPath(); d.arc(12, 12, 11, 0, 2 * Math.PI); d.fill()
        if (!dark) {
          const softness = d.createRadialGradient(12, 12, 8.5, 12, 12, 11)
          softness.addColorStop(0, '#fff'); softness.addColorStop(1, '#fff0')
          d.globalCompositeOperation = 'destination-in'; d.fillStyle = softness; d.fillRect(0, 0, 24, 24)
        }
        referenceBeads.push(dot)
      }
      ballLight = style.getPropertyValue('--hmc-ball-light').trim(); ballEdge = style.getPropertyValue('--hmc-ball-edge').trim()
      bead = document.createElement('canvas'); bead.width = bead.height = 48
      const sphere = bead.getContext('2d')!, shading = sphere.createRadialGradient(14.4, 12, 0, 14.4, 12, 43.2)
      const mid = style.getPropertyValue('--hmc-ball-mid').trim(), shadow = style.getPropertyValue('--hmc-ball-shadow').trim()
      shading.addColorStop(0, ballLight); shading.addColorStop(0.48, ballLight)
      shading.addColorStop(0.54, mid); shading.addColorStop(0.8, mid)
      shading.addColorStop(0.86, shadow); shading.addColorStop(1, shadow)
      sphere.fillStyle = shading; sphere.beginPath(); sphere.arc(24, 24, 24, 0, 2 * Math.PI); sphere.fill(); render()
    }
    const tick = (now: number) => {
      const delta = previousTime ? Math.min((now - previousTime) / 1000, 0.1) : 0
      previousTime = now; elapsed += delta * hmc.playbackRate
      if (!drag) camera.yaw += delta * 0.085
      if (elapsed >= hmc.momentumDuration + proposal.duration) commitProposal()
      if (elapsed >= hmc.momentumDuration + proposal.duration + hmc.decisionDuration) {
        proposal = propose(proposal.next); elapsed = 0; committed = false
      }
      if (now - lastRender >= 1000 / 40) { render(); lastRender = now }
      frame = requestAnimationFrame(tick)
    }
    const sync = () => {
      if (inView && desktop.matches && !document.hidden && !paused && !reducedMotion.matches) {
        if (!frame) frame = requestAnimationFrame(tick)
      } else { cancelAnimationFrame(frame); frame = 0; previousTime = 0 }
    }
    const resetView = () => { Object.assign(camera, hmc.initialCamera); render() }
    const togglePause = () => {
      paused = !paused
      pauseButton.setAttribute('aria-label', paused ? 'Resume sampling' : 'Pause sampling')
      pauseButton.title = paused ? 'Resume sampling (Space)' : 'Pause sampling (Space)'
      render(); sync()
    }
    const hideHint = () => { hint.dataset.visible = 'false' }
    const endDrag = () => {
      if (!drag) return
      const id = drag.id
      drag = null; plot.dataset.dragging = 'false'
      if (surface.hasPointerCapture(id)) surface.releasePointerCapture(id)
      hideHint(); sync()
    }
    plot.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch' || drag?.moved || (event.target instanceof Element && event.target.closest('button'))) { hideHint(); return }
      const center = event.target instanceof Element && !!event.target.closest('[data-hmc-center]')
      hint.textContent = center ? 'Hamiltonian Monte Carlo' : 'Drag!'; hint.dataset.center = String(center)
      const x = event.clientX + 14 + hint.offsetWidth > innerWidth - 8 ? event.clientX - hint.offsetWidth - 14 : event.clientX + 14
      const y = event.clientY + 16 + hint.offsetHeight > innerHeight - 8 ? event.clientY - hint.offsetHeight - 16 : event.clientY + 16
      hint.style.transform = `translate3d(${x}px, ${y}px, 0)`; hint.dataset.visible = 'true'
    })
    surface.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return
      drag = { id: event.pointerId, x: event.clientX, y: event.clientY, yaw: camera.yaw, elevation: camera.elevation, moved: false }
      surface.setPointerCapture(event.pointerId)
    })
    surface.addEventListener('pointermove', (event) => {
      if (!drag || drag.id !== event.pointerId) return
      // Recover if the mouse was released outside the window or lost focus.
      if (event.pointerType !== 'touch' && event.buttons === 0) { endDrag(); return }
      const dx = event.clientX - drag.x, dy = event.clientY - drag.y
      if (Math.hypot(dx, dy) > 4) drag.moved = true
      if (!drag.moved) return
      camera.yaw = drag.yaw + dx * 0.009
      camera.elevation = Math.max(-0.35, Math.min(1.2, drag.elevation + dy * 0.006))
      plot.dataset.dragging = 'true'; hideHint(); render()
    })
    const releaseDrag = (event: PointerEvent) => {
      if (!drag || drag.id !== event.pointerId) return
      endDrag()
    }
    window.addEventListener('pointerup', releaseDrag)
    window.addEventListener('blur', endDrag)
    surface.addEventListener('pointercancel', releaseDrag); surface.addEventListener('lostpointercapture', releaseDrag)
    plot.addEventListener('pointerleave', hideHint)
    surface.addEventListener('keydown', (event) => {
      if (event.key === ' ') { event.preventDefault(); togglePause() }
      else if (event.key.toLowerCase() === 'r') resetView()
      else if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(event.key)) {
        event.preventDefault(); camera.yaw += event.key === 'ArrowLeft' ? -0.12 : event.key === 'ArrowRight' ? 0.12 : 0
