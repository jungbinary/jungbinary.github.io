---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { pdfPosts } from '../../data/pdf-posts'
import { blogExcerpt } from '../../lib/blog-excerpt'
import '../../styles/blog.css'

const posts = await getCollection('blog', ({ data }) => !data.draft && !data.hiddenFromIndex)
const entries = [
  ...posts.map((post) => ({
    title: post.data.title,
    excerpt: blogExcerpt(post.rendered?.html, post.data.description),
    date: post.data.date,
    href: `/blog/${post.id}/`,
    tags: post.data.topics.length ? post.data.topics : ['post'],
  })),
  ...pdfPosts.map((post) => ({
    title: post.title,
    excerpt: blogExcerpt(undefined, post.description),
    date: new Date(post.date),
    href: `/notes/${post.slug}/`,
    tags: post.tags,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf())

const topics = new Map<string, string>()
for (const entry of entries) {
  for (const tag of entry.tags) topics.set(tag.toLowerCase(), tag)
}
const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
---

<BaseLayout title="Blog" description="Blog posts by Jungbin Jun." activePage="blog">
  <div class="journal-index">
    <header class="journal-masthead">
      <h1>blog<span>.</span></h1>
      <p class="journal-introduction">
        I am broadly interested in connections between seemingly disparate fields,
        especially when they reveal a shared underlying structure.
      </p>
      <svg class="journal-sketch" viewBox="0 0 148 100" aria-hidden="true" focusable="false">
        <path class="paper-edge" d="M13 60.1C32.8 65.6 57.8 80.2 79.9 83.7
          C89.5 77.7 103.3 69.2 113.9 63.3C103.8 70.9 90.5 78.7 80.7 86.1
          C59.6 82.4 35.3 68.1 13 60.1Z" />
        <path class="paper" d="M11.9 59.4C29.6 51.3 47.8 38.8 65.3 27.6
          C77.4 31 96.6 40.5 111.8 43.7Q116.3 51.4 125.1 55.8
          C110.2 64.2 93.4 76.6 80.2 84.4C58.7 80.7 31.9 65.2 11.9 59.4Z" />
        <path class="paper-fold" d="M111.8 43.7Q114.2 50.2 106.6 53.3
          Q116.8 51.9 125.1 55.8Q116.3 51.4 111.8 43.7Z" />
        <path class="graph-axes" d="M65.9 45.5Q55.6 52.3 43.4 59.5Q57.2 65.4 74.3 71.5" />
        <path class="pencil-shadow" d="M76 56.3Q87 51.7 99.5 46.3Q102.9 45.5 104.6 47.3
          Q91.3 51.2 76 56.3Z" />
        <path class="graph-line" d="M47.6 61C53.1 61.7 55.2 55.2 60.4 54.9
          C65.2 54.5 66.9 60.2 70.7 59.8C73.2 59.5 74.1 57.1 76.4 55.8
          C74.3 57.9 73.4 60.6 70.6 60.9C65.9 61.3 64.2 55.4 60.3 55.8
          C55.3 56.3 53.1 62.5 47.6 61Z" />
        <g transform="translate(76.4 55.8) rotate(-48)">
          <path class="pencil" d="M0 0Q6.5-2.1 12.4-4.4C27.8-4.6 46.3-5 61.8-4.7
            Q65.2-4.5 65.7-.9Q66 2.7 62.8 3.8C44.8 3.7 25.8 4.4 11.6 4.2Q5.8 1.9 0 0Z" />
          <path class="pencil-facet" d="M12.3-.5C27.2-1.1 46.4-.7 60.3-1.4
            Q62 1 60.8 3.5Q37.1 3.6 11.8 4Q13.6 1.9 12.3-.5Z" />
          <path class="pencil-wood" d="M.8 0 12.3-4.1Q13.7-2.2 11.9-.5Q13.6 1.7 11.5 3.9Z" />
          <path class="graphite" d="M-.5.1 4.6-1.7Q5.4-.1 4.1 1.4Z" />
          <path class="pencil-cap" d="M59.7-4.4Q62-.7 60.8 3.5" />
        </g>
      </svg>
    </header>

    <section class="journal-archive" aria-labelledby="archive-heading">
      <div class="archive-heading">
        <h2 id="archive-heading">posts</h2>
        {entries.length === 0 && <p class="archive-empty">No posts published yet.</p>}
        {entries.length > 1 && topics.size > 0 && (
          <div class="archive-filters topic-scroll" role="group" aria-label="Filter posts by topic" hidden>
            <button type="button" data-filter="" aria-pressed="true">all</button>
            {Array.from(topics, ([key, label]) => (
              <button type="button" data-filter={key} aria-pressed="false">{label}</button>
            ))}
          </div>
        )}
      </div>

      {entries.length > 0 && (
        <ol class="archive-entries" role="list">
          {entries.map((entry) => (
            <li class="archive-entry" data-tags={JSON.stringify(entry.tags.map((t) => t.toLowerCase()))}>
              <h3><a href={entry.href}>{entry.title}</a></h3>
              {entry.excerpt && <p class="entry-summary">{entry.excerpt}</p>}
              <div class="archive-entry-meta">
                <time datetime={entry.date.toISOString().slice(0, 10)}>{dateFormat.format(entry.date)}</time>
                {entry.tags.length > 0 && (
                  <span class="entry-topics topic-scroll" role="group" aria-label="Topics" tabindex="0">
                    {entry.tags.join(' · ')}
                  </span>
                )}
              </div>
            </li>
          ))}
        </ol>
      )}
      <span class="archive-announcement" role="status"></span>
    </section>

    <figure class="journal-epigraph">
      <blockquote>
        <p>“Mathematics is the art of giving the same name to different things.”</p>
      </blockquote>
      <figcaption>— Henri Poincaré</figcaption>
    </figure>
  </div>
</BaseLayout>

<script>
  const filters = document.querySelector<HTMLElement>('.archive-filters')
  if (filters) {
    const buttons = filters.querySelectorAll<HTMLButtonElement>('button')
    const entries = document.querySelectorAll<HTMLElement>('.archive-entry')
    const announcement = document.querySelector('.archive-announcement')
    filters.hidden = false
    filters.addEventListener('focusin', ({ target }) => {
      if (target instanceof HTMLButtonElement && target.matches(':focus-visible')) {
        target.scrollIntoView({ block: 'nearest', inline: 'nearest' })
      }
    })
    buttons.forEach((button) => button.addEventListener('click', () => {
      const topic = button.dataset.filter
      let count = 0
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)))
      entries.forEach((entry) => {
        const tags: string[] = JSON.parse(entry.dataset.tags || '[]')
        entry.hidden = Boolean(topic && !tags.includes(topic))
        if (!entry.hidden) count++
      })
      if (announcement) announcement.textContent = `${count} ${count === 1 ? 'post' : 'posts'} shown.`
    }))
  }
</script>
