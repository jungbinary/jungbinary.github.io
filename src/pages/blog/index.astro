---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import pdfPosts from '../../data/pdfPosts.json'

const posts = (
  await getCollection(
    'blog',
    ({ data }) => !data.draft && !data.hiddenFromIndex,
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const shortDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
})

const entries = [
  ...posts.map((post) => ({
    title: post.data.title,
    displayDate: shortDate.format(post.data.date),
    date: post.data.date,
    href: `/blog/${post.id}/`,
    tags: post.data.topics.length > 0 ? post.data.topics : ['post'],
  })),
  ...pdfPosts.map((post) => ({
    title: post.title,
    displayDate: shortDate.format(new Date(post.date)),
    date: new Date(post.date),
    href: `/notes/${post.slug}/`,
    tags: post.tags,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf())

const filters = [
  'all',
  ...new Set(entries.flatMap((entry) => entry.tags)),
]

---

<BaseLayout
  title="Blog"
  description="Blog posts by Jungbin Jun."
  activePage="blog"
>
  <div class="blog-page blog-index-page">
    <div class="blog-hero blog-index-hero">
      <h1>blog</h1>
    </div>

    <div class="post-filters" role="group" aria-label="Filter posts by tag">
      {
        filters.map((filter, index) => (
          <button
            type="button"
            class:list={['post-filter', { active: index === 0 }]}
            data-filter={filter.toLowerCase()}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            {filter}
          </button>
        ))
      }
    </div>

    <div class="post-feed" aria-live="polite">
      {
        entries.map((entry) => (
          <article
            class="post-feed-item"
            data-post-item
            data-tags={entry.tags.map((tag) => tag.toLowerCase()).join('|')}
          >
            <time datetime={entry.date.toISOString()}>{entry.displayDate}</time>
            <div class="post-feed-body">
              <div class="post-feed-tags">
                {entry.tags.map((tag) => <span class="post-feed-tag">{tag}</span>)}
              </div>
              <h2><a href={entry.href}>{entry.title}</a></h2>
            </div>
          </article>
        ))
      }
      <p class="post-feed-empty" data-empty-state hidden>
        No posts in this topic yet.
      </p>
    </div>
  </div>

  <script>
    const filterButtons = document.querySelectorAll('[data-filter]')
    const postItems = document.querySelectorAll('[data-post-item]')
    const emptyState = document.querySelector('[data-empty-state]')

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!(button instanceof HTMLButtonElement)) return
        const filter = button.dataset.filter || 'all'
        let visibleCount = 0

        filterButtons.forEach((item) => {
          const active = item === button
          item.classList.toggle('active', active)
          item.setAttribute('aria-pressed', active ? 'true' : 'false')
        })

        postItems.forEach((item) => {
          if (!(item instanceof HTMLElement)) return
          const tags = (item.dataset.tags || '').split('|')
          const visible = filter === 'all' || tags.includes(filter)
          item.hidden = !visible
          if (visible) visibleCount += 1
        })

        if (emptyState instanceof HTMLElement) {
          emptyState.hidden = visibleCount !== 0
        }
      })
    })
  </script>
</BaseLayout>
