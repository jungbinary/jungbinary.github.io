---
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import '../styles/site.css'
import '../styles/components.css'

const lastUpdatedAt = import.meta.env.LAST_UPDATED_AT || new Date().toISOString()
const defaultLastUpdated = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Seoul',
}).format(new Date(lastUpdatedAt))

const {
  title = 'Jungbin Jun',
  description = 'Jungbin Jun — incoming M.S. student at POSTECH researching trustworthy AI and conformal prediction.',
  activePage = 'about',
  lastUpdated = defaultLastUpdated,
  lastUpdatedFallback = defaultLastUpdated,
  math = false,
  noindex = false,
  type = 'website',
} = Astro.props

function blogUpdatedMonth(value: string, fallback: string) {
  // Date-only metadata is a calendar date, independent of the reader's timezone.
  const calendarDate = (text: string) => {
    const iso = /^(\d{4}-\d{2})(?:$|-)/.exec(text)
    if (iso) return new Date(iso[1] + '-01T12:00:00')
    const hasMonth = /\b(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)/i.test(text)
    const year = fallback.match(/\b\d{4}\b/)?.[0]
    return new Date(hasMonth && year && !/\b\d{4}\b/.test(text) ? text + ' ' + year : text)
  }
  const parsed = calendarDate(value)
  const date = Number.isNaN(parsed.valueOf()) ? calendarDate(fallback) : parsed
  return date.toLocaleString('en-US', { month: 'long' }) + ', ' + date.getFullYear()
}

const footerDate = activePage === 'blog' ? blogUpdatedMonth(lastUpdated, lastUpdatedFallback) : lastUpdated
const fullTitle = title === 'Jungbin Jun' ? title : `${title} - Jungbin Jun`
const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const socialImageUrl = new URL('/og.png', Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="Jungbin Jun" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta
      name="google-site-verification"
      content="SSDsp-zlQNbaudw2xXZiJGgd4tecbTb9ALBDyH5NEpY"
    />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{fullTitle}</title>

    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('jungbin-theme')
          const prefersDark = window.matchMedia?.(
            '(prefers-color-scheme: dark)',
          ).matches
          document.documentElement.dataset.theme =
            savedTheme || (prefersDark ? 'dark' : 'light')
        } catch {
          document.documentElement.dataset.theme = 'light'
        }
      })()
    </script>

    <script is:inline data-site-origin={Astro.site?.origin}>
      (() => {
        if (location.origin !== document.currentScript.dataset.siteOrigin) return
        const measurementId = 'G-5SS15L5BV9'
        window.dataLayer = window.dataLayer || []
        window.gtag = function () { window.dataLayer.push(arguments) }
        window.gtag('js', new Date())
        window.gtag('config', measurementId)

        const script = document.createElement('script')
        script.async = true
        script.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId
        document.head.appendChild(script)
      })()
    </script>
    {
      math && (
        <script
          is:inline
          defer
          src="https://cdn.jsdelivr.net/npm/mathjax@4/tex-mml-chtml.js"
        />
      )
    }
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/jpswalsh/academicons@1/css/academicons.min.css"
    />
  </head>
  <body>
    <div class="site-shell" data-page={activePage}>
      <SiteHeader activePage={activePage} />
      <main>
        <slot />
      </main>
      <SiteFooter lastUpdated={footerDate} />
    </div>

    <script is:inline>
      (() => {
        const toggle = document.querySelector('.theme-toggle')
        if (!(toggle instanceof HTMLButtonElement)) return

        const updateLabel = () => {
          const isDark = document.documentElement.dataset.theme === 'dark'
          toggle.setAttribute(
            'aria-label',
            isDark ? 'turn off dark mode' : 'turn on dark mode',
          )
        }

        updateLabel()
        toggle.addEventListener('click', () => {
          const nextTheme =
            document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
          document.documentElement.dataset.theme = nextTheme
          updateLabel()

          try {
            localStorage.setItem('jungbin-theme', nextTheme)
          } catch {}
        })
      })()
    </script>
  </body>
</html>
