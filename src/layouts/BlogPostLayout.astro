---
import BaseLayout from './BaseLayout.astro'
import '../styles/blog-reading.css'

const {
  title,
  description,
  date,
  displayDate,
  topics = [],
  math = false,
  lastUpdated = displayDate,
} = Astro.props

const dateTime =
  date instanceof Date ? date.toISOString().slice(0, 10) : String(date)
const visibleDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
}).format(date instanceof Date ? date : new Date(date))
---

<BaseLayout
  title={title}
  description={description}
  activePage="blog"
  lastUpdated={lastUpdated}
  lastUpdatedFallback={dateTime}
  math={math}
  type="article"
>
  <article class="blog-page blog-article" data-copy-protected>
    <header class="blog-hero">
      <h1>{title}</h1>
      <div class="blog-post-meta">
        <time datetime={dateTime}>{visibleDate}</time>
        {topics.length > 0 && (
          <ul class="blog-post-topics topic-scroll" role="list" aria-label="Topics" tabindex="0">
            {topics.map((topic: string) => <li class="blog-topic">#{topic}</li>)}
          </ul>
        )}
      </div>
    </header>

    <div class="blog-section blog-post-body">
      <slot />

      <div class="back-to-posts">
        <a href="/blog/" class="pill-link">
          <i class="fa fa-arrow-left" aria-hidden="true"></i>
          Back to posts
        </a>
      </div>
    </div>
  </article>

  <script>
    const protectedPost = document.querySelector('[data-copy-protected]')

    protectedPost?.addEventListener('copy', (event) => {
      event.preventDefault()
    })

    protectedPost?.addEventListener('cut', (event) => {
      event.preventDefault()
    })
  </script>
</BaseLayout>
